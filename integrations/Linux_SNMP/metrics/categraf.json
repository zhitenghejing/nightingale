[
  {
    "uuid": 1800000000000100,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "CPU usage",
    "unit": "percent",
    "note": "Device-scoped cpu usage.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "CPU usage",
        "note": "Device-scoped cpu usage."
      },
      {
        "lang": "zh_CN",
        "name": "CPU 使用率",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "avg by (collection_device_id, collection_revision) (snmp_cpu_load{collection_mode=\"managed\"})",
    "expression_type": "promql",
    "metric_type": "gauge"
  },
  {
    "uuid": 1800000000000101,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "Memory usage",
    "unit": "percent",
    "note": "Device-scoped memory usage.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "Memory usage",
        "note": "Device-scoped memory usage."
      },
      {
        "lang": "zh_CN",
        "name": "内存使用率",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "100 * snmp_storage_used{type=~\"\\\\.?1\\\\.3\\\\.6\\\\.1\\\\.2\\\\.1\\\\.25\\\\.2\\\\.1\\\\.2\",collection_mode=\"managed\"} / (snmp_storage_size{type=~\"\\\\.?1\\\\.3\\\\.6\\\\.1\\\\.2\\\\.1\\\\.25\\\\.2\\\\.1\\\\.2\",collection_mode=\"managed\"} > 0)",
    "expression_type": "promql",
    "metric_type": "gauge"
  },
  {
    "uuid": 1800000000000102,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "Disk usage",
    "unit": "percent",
    "note": "Device-scoped disk usage.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "Disk usage",
        "note": "Device-scoped disk usage."
      },
      {
        "lang": "zh_CN",
        "name": "磁盘使用率",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "100 * snmp_storage_used{type=~\"\\\\.?1\\\\.3\\\\.6\\\\.1\\\\.2\\\\.1\\\\.25\\\\.2\\\\.1\\\\.4\",collection_mode=\"managed\"} / (snmp_storage_size{type=~\"\\\\.?1\\\\.3\\\\.6\\\\.1\\\\.2\\\\.1\\\\.25\\\\.2\\\\.1\\\\.4\",collection_mode=\"managed\"} > 0)",
    "expression_type": "promql",
    "metric_type": "gauge"
  },
  {
    "uuid": 1800000000000103,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "Network inbound",
    "unit": "bits/sec",
    "note": "Device-scoped network inbound.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "Network inbound",
        "note": "Device-scoped network inbound."
      },
      {
        "lang": "zh_CN",
        "name": "网络入站",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "8 * (rate(snmp_traffic64_in_octets{collection_mode=\"managed\"}[5m]) or on(collection_device_id,collection_revision,index) rate(snmp_traffic32_in_octets{collection_mode=\"managed\"}[5m]))",
    "expression_type": "promql",
    "metric_type": "gauge"
  },
  {
    "uuid": 1800000000000104,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "Network outbound",
    "unit": "bits/sec",
    "note": "Device-scoped network outbound.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "Network outbound",
        "note": "Device-scoped network outbound."
      },
      {
        "lang": "zh_CN",
        "name": "网络出站",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "8 * (rate(snmp_traffic64_out_octets{collection_mode=\"managed\"}[5m]) or on(collection_device_id,collection_revision,index) rate(snmp_traffic32_out_octets{collection_mode=\"managed\"}[5m]))",
    "expression_type": "promql",
    "metric_type": "gauge"
  },
  {
    "uuid": 1800000000000105,
    "collector": "categraf",
    "typ": "Linux_SNMP",
    "name": "SNMP uptime",
    "unit": "seconds",
    "note": "Device-scoped snmp uptime.",
    "lang": "en_US",
    "translation": [
      {
        "lang": "en_US",
        "name": "SNMP uptime",
        "note": "Device-scoped snmp uptime."
      },
      {
        "lang": "zh_CN",
        "name": "SNMP 运行时长",
        "note": "仅查询当前设备的受管采集数据。"
      }
    ],
    "expression": "snmp_uptime{collection_mode=\"managed\"} / 100",
    "expression_type": "promql",
    "metric_type": "gauge"
  }
]
