[
  {
    "uuid": 1850000000200000,
    "name": "CPU usage above 90%",
    "cate": "prometheus",
    "prod": "metric",
    "disabled": 0,
    "prom_for_duration": 300,
    "prom_eval_interval": 15,
    "rule_config": {
      "queries": [
        {
          "prom_ql": "avg by (ident, collection_device_id, collection_revision, device_name) (snmp_cpu_load{collection_mode=\"managed\"}) > 90",
          "severity": 2,
          "unit": "percent"
        }
      ],
      "version": "v1"
    },
    "notify_version": 1,
    "notify_rule_ids": [],
    "notify_recovered": 1,
    "notify_repeat_step": 60,
    "annotations": {
      "action": "Check ICMP and SNMP access, credentials and resource utilization. Optional OID absence does not imply a baseline collection failure. Configure native notification rules as needed."
    },
    "enable_stimes": [
      "00:00"
    ],
    "enable_etimes": [
      "23:59"
    ],
    "enable_days_of_weeks": [
      [
        "0",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    ]
  },
